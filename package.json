    "dompurify": "^3.4.17",
    "img-fx": "^0.5.1",
    "liquid-gooey": "^0.2.2",
    "marked": "^18.1.1",
    "metal-fx": "^2.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "thinking-orbs": "^0.3.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
